[branch]
	sort = -committerdate  # Sort branches by most recent commit first

[checkout]
	workers = -1  # Use all available CPU cores for checkout operations

[column]
	ui = auto  # Enable columnar output when terminal is wide enough

[commit]
	verbose = true  # Show diff in commit message editor

[core]
	commitGraph = true  # Enable commit-graph for faster operations
	fsmonitor = true  # Monitor filesystem for changes to speed up status
	pager = delta  # Use delta as the default pager for diffs
	untrackedCache = true  # Cache untracked files for faster status

[diff]
	algorithm = histogram  # Use histogram algorithm for better diffs
	colorMoved = plain  # Highlight moved lines in diffs
	mnemonicPrefix = true  # Use more descriptive prefixes (i/w/c/o instead of a/b)
	renames = true  # Detect file renames in diffs

[feature]
	manyFiles = true  # Optimize for repositories with many files

[fetch]
	all = true  # Fetch from all remotes by default
	pruneTags = true  # Remove local tags that don't exist on remote
	prune = true  # Remove remote-tracking branches that no longer exist
	writeCommitGraph = true  # Update commit-graph during fetch

[gpg]
	format = ssh  # Use SSH keys for signing instead of GPG

[index]
	version = 4  # Use index format version 4 (supports longer paths)

[init]
	defaultBranch = main  # Use 'main' as default branch name

[interactive]
	diffFilter = delta --color-only  # Use delta for interactive diffs

[merge]
	conflictstyle = zdiff3  # Show original, ours, theirs in merge conflicts

[rebase]
	autoSquash = true  # Automatically squash fixup! and squash! commits
	autoStash = true  # Stash changes before rebase, pop after

[receive]
	fsckObjects = true  # Check objects when receiving pushes

[rerere]
	autoUpdate = true  # Update rerere resolution when conflicts change
	enabled = true  # Remember and reuse merge conflict resolutions

[pull]
	rebase = true  # Rebase instead of merge when pulling

[push]
	autoSetupRemote = true  # Automatically set up remote tracking
	followTags = true  # Push annotated tags with commits

[tag]
	sort = version:refname  # Sort tags by version number

[transfer]
	fsckObjects = true  # Check objects during push/fetch

[user]
	name = Carlos Hernando
	email = chernando@users.noreply.github.com
	signingKey = ~/.ssh/id_ed25519.pub  # SSH key for commit signing

[delta]
	side-by-side = true  # Show diffs side by side
	navigate = true  # Enable navigation in delta
	true-color = always  # Use 24-bit color

[filter "lfs"]
	clean = git-lfs clean -- %f  # Convert files to LFS pointers when staging
	smudge = git-lfs smudge -- %f  # Replace LFS pointers with actual file content
	process = git-lfs filter-process  # Use long-running process via pkt-line protocol
	required = true  # Fail if LFS is unavailable

[include]
	path = ~/.gitconfig.local  # Include local Git config overrides
