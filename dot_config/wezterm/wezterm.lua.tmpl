local wezterm = require("wezterm")
local config = wezterm.config_builder()

-- Initial geometry for new windows:
config.initial_cols = 160
config.initial_rows = 32

config.color_scheme = "Solarized - Light"

-- wezterm bundles JetBrains Mono (with Nerd Fonts)
-- JetBrains Mono recommends these options:
{{- if eq .chezmoi.os "darwin" }}
config.font_size = 14.0 -- increased from 13 due to glitch
{{- else }}
config.font_size = 13.0
{{- end }}
config.line_height = 1.2

{{- if eq .chezmoi.os "darwin" }}
config.set_environment_variables = {
	PATH = "/opt/homebrew/bin:" .. (os.getenv("PATH") or "")
}
{{- end }}

config.default_prog = { "/usr/bin/env", "fish" }

config.keys = {
	{ key = "Enter", mods = "SHIFT", action = wezterm.action({ SendString = "\x1b\r" }) },
}

config.quit_when_all_windows_are_closed = false
config.warn_about_missing_glyphs = false
config.audible_bell = "Disabled"
config.visual_bell = {
  fade_in_function = 'EaseIn',
  fade_in_duration_ms = 150,
  fade_out_function = 'EaseOut',
  fade_out_duration_ms = 150,
}
config.colors = {
  visual_bell = '#202020',
}

return config
